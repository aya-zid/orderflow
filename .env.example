# ---------------------------------------------------------------------------
# OrderFlow — local development environment
# Copy to .env before running `docker compose up`.
# ---------------------------------------------------------------------------

# Application
ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=orderflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=orderflow.events

# Redis
REDIS_PORT=6379

# Services
GATEWAY_PORT=8080
ORDER_PORT=8081
INVENTORY_PORT=8082
PAYMENT_PORT=8083
NOTIFICATION_PORT=8084
SWAGGER_PORT=8085

# Payment simulation (0.0 = always succeeds, 1.0 = always fails)
PAYMENT_FAILURE_RATE=0.1

# Gateway rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
